{
    "extends": [
        "config:base",
        "helpers:pinGitHubActionDigests"
    ],
    "dependencyDashboard": false,
    "labels": [
        "dependencies"
    ],
    "automergeType": "pr",
    "automergeStrategy": "auto",
    "major": {
        "automerge": false
    },
    "minor": {
        "automerge": true,
        "groupName": "minor dependencies",
        "groupSlug": "all-minor",
        "platformAutomerge": true,
        "stabilityDays": 3
    },
    "patch": {
        "automerge": true,
        "groupName": "patch dependencies",
        "groupSlug": "all-patch",
        "platformAutomerge": true,
        "stabilityDays": 0
    },
    "digest": {
        "automerge": true,
        "groupName": "digest dependencies",
        "groupSlug": "all-digest",
        "platformAutomerge": true,
        "stabilityDays": 0
    },

    "lockFileMaintenance": {
        "enabled": true,
        "automerge": true,
        "platformAutomerge": true
    },
    "pre-commit": {
        "enabled": true
    },
    "packageRules": [
        {
            "matchPackageNames": ["python"],
            "enabled": false
        },
        {
            "matchPackageNames": [
                "python"
            ],
            "enabled": false,
            "platformAutomerge": true
        },
        {
            "matchDepTypes": [
                "devDependencies",
                "dev-packages"
            ],
            "automerge": true,
            "platformAutomerge": true
        },
        {
            "description": "Isolate SQLAlchemy from the minor-dependencies group — sqlalchemy-continuum==1.7.0 pins SQLAlchemy<2.1, so bumping it as part of the grouped minor PR breaks pipenv lock for backend/ops_api and backend/data_tools and blocks unrelated updates. Remove this rule once sqlalchemy-continuum (or its replacement) supports SQLAlchemy>=2.1.",
            "matchPackageNames": ["SQLAlchemy", "sqlalchemy"],
            "groupName": "sqlalchemy (blocked by sqlalchemy-continuum)",
            "groupSlug": "sqlalchemy-continuum-blocked",
            "separateMinorPatch": true
        }
    ],
    "prBodyTemplate": "{{{header}}}{{{table}}}{{{notes}}}{{{changelogs}}}{{{controls}}}{{{footer}}}"
}
